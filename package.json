{
  "name": "loom-home-assistant-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @loom/shared && npm run build -w @loom/web && npm run build -w @loom/server",
    "dev": "npm run dev -w @loom/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run build -w @loom/shared && npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "html-to-text": "^10.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4"
  }
}
